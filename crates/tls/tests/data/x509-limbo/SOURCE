How to make it again: run these commands, with limbo.json the file of the commit above. With jq
1.8.2 (`jq --version`: jq-1.8.2) they make the five files byte for byte.

  jq -c -f subset.jq limbo.json > kept.json
  jq -c '.testcases |= map(select(.id != "online::facebook.com") | del(.peer_certificate_key))' kept.json > subset.json
  jq -c --arg part other -f split.jq subset.json > limbo-other.json
  for i in 1 2 3 4; do
    jq -c --arg part "$i" -f split.jq subset.json > "limbo-bettertls-$i.json"
  done

subset.jq:

  .testcases as $t
  | ([$t[] | select(.id | startswith("bettertls::") | not) | tojson | utf8bytelength] | add) as $other
  | (reduce ($t[] | select(.id | startswith("bettertls::")) | tojson | utf8bytelength) as $n
      ({sum: $other, k: 0, stop: false};
       if .stop then .
       elif .sum + $n <= 20971520 then .sum += $n | .k += 1
       else .stop = true end)) as $r
  | ([$t[] | select(.id | startswith("bettertls::")) | .id][0:$r.k]) as $kept
  | ($kept | map({key: ., value: true}) | from_entries) as $keep
  | {version: .version,
     testcases: [$t[] | select((.id | startswith("bettertls::") | not) or ($keep[.id] // false))]}

split.jq:

  .version as $v
  | [.testcases[] | select(.id | startswith("bettertls::") | not)] as $other
  | [.testcases[] | select(.id | startswith("bettertls::"))] as $b
  | ($b | length) as $n
  | (($n + 3) / 4 | floor) as $k
  | if $part == "other" then {version: $v, testcases: $other}
    else ($part | tonumber) as $i | {version: $v, testcases: $b[($i - 1) * $k : $i * $k]}
    end

